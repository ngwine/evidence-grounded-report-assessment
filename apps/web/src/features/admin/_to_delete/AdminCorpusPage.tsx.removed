import { useEffect, useMemo, useState } from "react";
import { AdminSubNav } from "./AdminSubNav";
import { createCorpusSource, getCorpusSources, setCorpusSourceStatus } from "../../lib/api";
import type { CorpusSource, CorpusSourceStatus, CorpusSourceType } from "../../lib/types";
import { StatusBadge } from "../../components/StatusBadge";
import { corpusSourceStatusLabel, corpusSourceTypeLabel } from "../../lib/statusMaps";
import { formatDateTime } from "../../lib/format";
import "./admin.css";

const TYPE_OPTIONS: { value: CorpusSourceType; label: string }[] = [
  { value: "INTERNAL_REPORT", label: corpusSourceTypeLabel.INTERNAL_REPORT },
  { value: "EXTERNAL_DOC", label: corpusSourceTypeLabel.EXTERNAL_DOC },
  { value: "WEB", label: corpusSourceTypeLabel.WEB },
];

const STATUS_FILTER_OPTIONS: CorpusSourceStatus[] = ["PENDING", "APPROVED", "REJECTED"];

/**
 * Man "Admin / Quan ly nguon doi chieu" (UC-15) -- ban DEMO theo yeu cau
 * "lam thu xem" cua Yen (2026-10-29).
 *
 * LUU Y: bo-use-case.md ghi actor cua UC-15 la "Giang vien" (KHONG phai
 * "Quan tri vien") -- dang dat man nay o Admin de Yen hinh dung UI truoc,
 * CAN XAC NHAN LAI voi Quy xem co nen chuyen man nay (hoac them 1 ban o
 * phia Giang vien) truoc khi lam API that.
 *
 * Nguon doi chieu la tai lieu dung lam "nguon" de so sanh/phat hien trung
 * lap o chang Similarity (xem mockSimilarityMatches) -- Admin dang ky +
 * duyet/tu choi 1 nguon o day truoc khi no duoc dung trong doi chieu.
 */
export function AdminCorpusPage() {
  const [rows, setRows] = useState<CorpusSource[] | null>(null);
  const [statusFilter, setStatusFilter] = useState<CorpusSourceStatus | "">("");
  const [pendingSourceId, setPendingSourceId] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  const [isFormOpen, setIsFormOpen] = useState(false);
  const [title, setTitle] = useState("");
  const [sourceType, setSourceType] = useState<CorpusSourceType>("INTERNAL_REPORT");
  const [isSaving, setIsSaving] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);

  function reload() {
    getCorpusSources().then(setRows);
  }

  useEffect(() => {
    reload();
  }, []);

  const filteredRows = useMemo(() => {
    return (rows ?? []).filter((row) => statusFilter === "" || row.status === statusFilter);
  }, [rows, statusFilter]);

  function resetForm() {
    setTitle("");
    setSourceType("INTERNAL_REPORT");
    setFormError(null);
  }

  function handleCancelCreate() {
    setIsFormOpen(false);
    resetForm();
  }

  const canSubmit = useMemo(() => title.trim().length > 0, [title]);

  async function handleCreate() {
    if (!canSubmit) return;

    setIsSaving(true);
    setFormError(null);
    try {
      await createCorpusSource({ title: title.trim(), sourceType });
      resetForm();
      setIsFormOpen(false);
      reload();
    } catch (error) {
      setFormError(error instanceof Error ? error.message : "Có lỗi xảy ra.");
    } finally {
      setIsSaving(false);
    }
  }

  async function handleDecide(row: CorpusSource, status: CorpusSourceStatus) {
    const confirmMessage =
      status === "APPROVED"
        ? `Duyệt nguồn "${row.title}" để dùng trong đối chiếu Similarity?`
        : `Từ chối nguồn "${row.title}"?`;
    if (!window.confirm(confirmMessage)) return;

    setErrorMessage(null);
    setPendingSourceId(row._id);
    try {
      await setCorpusSourceStatus(row._id, status);
      reload();
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : "Có lỗi xảy ra.");
    } finally {
      setPendingSourceId(null);
    }
  }

  return (
    <section className="panel">
      <AdminSubNav active="corpus" />

      <div className="panel__header">
        <div>
          <h1 className="panel__title">Quản lý nguồn đối chiếu</h1>
          <p className="panel__subtitle">
            Tài liệu dùng làm nguồn so khớp ở chặng Similarity — đăng ký nguồn
            mới, duyệt/từ chối. (Bản demo minh hoạ UI, chưa nối backend thật.)
          </p>
        </div>
        <button type="button" className="btn-primary" onClick={() => setIsFormOpen(true)}>
          + Thêm nguồn
        </button>
      </div>

      {isFormOpen && (
        <div className="modal-overlay" role="presentation">
          <div className="modal" role="dialog" aria-modal="true" aria-labelledby="create-corpus-modal-title">
            <div className="modal__header">
              <h2 id="create-corpus-modal-title" className="modal__title">
                Thêm nguồn đối chiếu
              </h2>
              <button type="button" className="modal__close" aria-label="Đóng" onClick={handleCancelCreate}>
                ×
              </button>
            </div>

            <label className="modal__field">
              <span className="modal__label">Tên tài liệu / nguồn</span>
              <input
                className="modal__select"
                value={title}
                onChange={(event) => setTitle(event.target.value)}
                placeholder="VD: Báo cáo KLTN khoá 2024"
              />
            </label>
            <label className="modal__field">
              <span className="modal__label">Loại nguồn</span>
              <select
                className="modal__select"
                value={sourceType}
                onChange={(event) => setSourceType(event.target.value as CorpusSourceType)}
              >
                {TYPE_OPTIONS.map((option) => (
                  <option key={option.value} value={option.value}>
                    {option.label}
                  </option>
                ))}
              </select>
            </label>

            {formError && <p className="panel__hint admin-users__error">{formError}</p>}

            <div className="admin-workspaces__form-actions">
              <button type="button" className="btn-secondary" onClick={handleCancelCreate}>
                Huỷ
              </button>
              <button type="button" className="btn-primary" disabled={!canSubmit || isSaving} onClick={handleCreate}>
                {isSaving ? "Đang lưu..." : "Thêm nguồn"}
              </button>
            </div>
          </div>
        </div>
      )}

      <div className="admin-users__filters">
        <select
          className="admin-users__status-select"
          value={statusFilter}
          onChange={(event) => setStatusFilter(event.target.value as CorpusSourceStatus | "")}
          aria-label="Lọc theo trạng thái"
        >
          <option value="">Tất cả trạng thái</option>
          {STATUS_FILTER_OPTIONS.map((value) => (
            <option key={value} value={value}>
              {corpusSourceStatusLabel[value].label}
            </option>
          ))}
        </select>
      </div>

      {errorMessage && <p className="panel__hint admin-users__error">{errorMessage}</p>}

      {rows === null && <p className="panel__hint">Đang tải...</p>}

      {rows !== null && filteredRows.length === 0 && (
        <p className="panel__hint">
          {rows.length === 0 ? "Chưa có nguồn đối chiếu nào." : "Không có nguồn phù hợp."}
        </p>
      )}

      {filteredRows.length > 0 && (
        <table className="data-table">
          <thead>
            <tr>
              <th>Nguồn</th>
              <th>Loại</th>
              <th>Người đăng ký</th>
              <th>Ngày đăng ký</th>
              <th>Trạng thái</th>
              <th className="admin-users__action-cell"></th>
            </tr>
          </thead>
          <tbody>
            {filteredRows.map((row) => {
              const statusChip = corpusSourceStatusLabel[row.status];
              const isPending = pendingSourceId === row._id;

              return (
                <tr key={row._id}>
                  <td>{row.title}</td>
                  <td>{corpusSourceTypeLabel[row.sourceType]}</td>
                  <td>{row.submittedByName}</td>
                  <td>{formatDateTime(row.submittedAt)}</td>
                  <td>
                    <StatusBadge label={statusChip.label} tone={statusChip.tone} />
                  </td>
                  <td className="admin-users__action-cell">
                    {row.status === "PENDING" && (
                      <>
                        <button
                          type="button"
                          className="btn-secondary admin-users__toggle-btn"
                          disabled={isPending}
                          onClick={() => handleDecide(row, "REJECTED")}
                        >
                          Từ chối
                        </button>{" "}
                        <button
                          type="button"
                          className="btn-primary admin-users__toggle-btn"
                          disabled={isPending}
                          onClick={() => handleDecide(row, "APPROVED")}
                        >
                          Duyệt
                        </button>
                      </>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </section>
  );
}
