{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kltn.local/schemas/similarity-report-v1.schema.json",
  "title": "Similarity Report v1",
  "type": "object",
  "required": [
    "schema_version", "pipeline", "classification_policy",
    "semantic_classifier_available", "report_chunk_count", "source_chunk_count",
    "total_report_tokens", "flagged_passage_coverage_percentage",
    "provisional_review_passage_coverage_percentage", "exact_match_coverage_percentage",
    "calibrated_similarity_percentage", "matches"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline": {"type": "string", "minLength": 1},
    "classification_policy": {"type": "string", "minLength": 1},
    "semantic_classifier_available": {"type": "boolean"},
    "report_chunk_count": {"type": "integer", "minimum": 0},
    "source_chunk_count": {"type": "integer", "minimum": 0},
    "total_report_tokens": {"type": "integer", "minimum": 0},
    "flagged_passage_coverage_percentage": {"type": "number", "minimum": 0, "maximum": 100},
    "provisional_review_passage_coverage_percentage": {"type": "number", "minimum": 0, "maximum": 100},
    "exact_match_coverage_percentage": {"type": "number", "minimum": 0, "maximum": 100},
    "calibrated_similarity_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_chunk_id", "source_chunk_id", "source_document_id",
          "classification_status", "selected_for_manual_review",
          "selected_for_document_coverage", "similarity_type", "alignment"
        ],
        "properties": {
          "report_chunk_id": {"type": "string", "minLength": 1},
          "source_chunk_id": {"type": "string", "minLength": 1},
          "source_document_id": {"type": "string", "minLength": 1},
          "classification_status": {"type": "string", "minLength": 1},
          "selected_for_manual_review": {"type": "boolean"},
          "selected_for_document_coverage": {"type": "boolean"},
          "similarity_type": {"type": ["string", "null"]},
          "alignment": {"type": "object"}
        }
      }
    }
  }
}
