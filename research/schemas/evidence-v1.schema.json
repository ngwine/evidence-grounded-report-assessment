{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kltn.local/schemas/evidence-v1.schema.json",
  "title": "Traceable Evidence v1",
  "type": "object",
  "required": [
    "evidence_id", "chunk_id", "document_id", "document_version_id",
    "rank", "excerpt", "source_spans"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "document_version_id": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1},
    "excerpt": {"type": "string"},
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id", "document_version_id", "element_key", "element_type",
          "element_raw_char_start", "element_raw_char_end",
          "element_normalized_char_start", "element_normalized_char_end",
          "chunk_raw_char_start", "chunk_raw_char_end",
          "chunk_normalized_char_start", "chunk_normalized_char_end", "locator"
        ],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "document_version_id": {"type": "string", "minLength": 1},
          "element_key": {"type": "string", "minLength": 1},
          "element_type": {"type": "string", "minLength": 1},
          "element_raw_char_start": {"type": "integer", "minimum": 0},
          "element_raw_char_end": {"type": "integer", "minimum": 1},
          "element_normalized_char_start": {"type": "integer", "minimum": 0},
          "element_normalized_char_end": {"type": "integer", "minimum": 1},
          "chunk_raw_char_start": {"type": "integer", "minimum": 0},
          "chunk_raw_char_end": {"type": "integer", "minimum": 1},
          "chunk_normalized_char_start": {"type": "integer", "minimum": 0},
          "chunk_normalized_char_end": {"type": "integer", "minimum": 1},
          "locator": {"type": "object", "minProperties": 1}
        }
      }
    }
  }
}
