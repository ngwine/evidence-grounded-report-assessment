APP_ENV=development
APP_NAME=kltn-plagiarism-assessment
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
APP_SECRET_KEY=change-me-in-local-env

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=kltn_plagiarism_assessment
MONGODB_SEARCH_ENABLED=false

FILE_STORAGE_ROOT=./var/uploads
MODEL_STORAGE_ROOT=./var/models
LOCAL_AI_BASE_URL=http://localhost:11434

# Indexing
BM25_INDEX_BACKEND=mongodb
DENSE_VECTOR_INDEX_BACKEND=mongodb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Evidence Graph
GRAPH_STORE_BACKEND=mongodb
GRAPH_STORE_URI=mongodb://localhost:27017

# Worker
WORKER_CONCURRENCY=2
WORKER_TASK_TIMEOUT=600

EXTERNAL_SEARCH_ENABLED=false
SEARCH_PROVIDER=disabled
